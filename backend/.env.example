# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/oslab
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/oslab?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/oslab

# JWT Configuration (Use a strong random string in production)
JWT_SECRET=oslab_secure_jwt_secret_change_in_production_key_2026
JWT_EXPIRES_IN=1d

# Allowed Frontend URL(s) for CORS
# Supports single URL, comma-separated URLs, or *
# Local development: http://localhost:5173
# Production on Render: https://your-app-name.vercel.app
FRONTEND_URL=http://localhost:5173
